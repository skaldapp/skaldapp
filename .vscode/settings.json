{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": ["source.fixAll.eslint"],
  "eslint.validate": ["typescript", "vue", "json"],
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "cSpell.language": "en,ru",
  "cSpell.words": [
    "Bruwes",
    "deflist",
    "iconify",
    "intlify",
    "jsonrepair",
    "milkdown",
    "monacopilot",
    "mqtt",
    "nojekyll",
    "nord",
    "noto",
    "nuxtlabs",
    "pinia",
    "qmarkdown",
    "skaldapp",
    "trystero",
    "unhead",
    "unocss",
    "vite",
    "vuejs",
    "vueuse",
    "wicg",
    "workgroups"
  ],
  "Codegeex.CommitMessage.LanguagePreference": "English",
  "Codegeex.Comment.LanguagePreference": "English",
  "Codegeex.Chat.LanguagePreference": "English",
  "Codegeex.SidebarUI.LanguagePreference": "English",
  "Codegeex.CommitMessageStyle": "ConventionalCommits"
}
